# Application
APP_NAME=Procura AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/procura_ai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# SECRET_KEY must be at least 32 characters (256 bits) for HS256
SECRET_KEY=change-me-in-production-to-a-secure-256bit-key
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_ARGON2_MEMORY=19456
PASSWORD_ARGON2_TIME=2
PASSWORD_ARGON2_PARALLELISM=1

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Logging
LOG_LEVEL=DEBUG
