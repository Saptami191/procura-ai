# Application
APP_NAME=Procura AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Database (configured in Milestone 3)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/procura_ai

# Redis (configured in Milestone 4)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-in-production
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Logging
LOG_LEVEL=DEBUG
